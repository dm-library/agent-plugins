#!/bin/sh
# 生成文件，请勿手改：源文件是 launcher/memory-hook，改完运行 sh scripts/sync-launcher.sh
# memory-hook 启动器：插件仓库里只提交这个几 KB 的脚本，真二进制按版本从 GitHub Releases 下载到
#   ${XDG_DATA_HOME:-~/.local/share}/deep-memory/bin/<version>/memory-hook
# 校验 sha256 后 exec。三条取二进制的路径，按优先级：
#   1. 同目录 memory-hook.local（本地覆盖，不提交）
#   2. 环境变量 DM_HOOK_BIN 指向的可执行文件
#   3. 版本缓存；没有则下载。404、其他非 2xx、空正文、校验失败都要写明原因并以非 0 退出，
#      安装命令和 session-start / stop / session-end 都不能静默空跑。
set -eu

here=$(cd "$(dirname "$0")" && pwd)
if [ -x "$here/memory-hook.local" ]; then
  exec "$here/memory-hook.local" "$@"
fi
if [ -n "${DM_HOOK_BIN:-}" ] && [ -x "$DM_HOOK_BIN" ]; then
  exec "$DM_HOOK_BIN" "$@"
fi

version=$(cat "$here/VERSION" 2>/dev/null || echo "")
if [ -z "$version" ]; then
  echo "memory-hook: 缺少 $here/VERSION" >&2
  exit 0
fi
repo=${DM_PLUGIN_REPO:-dm-library/agent-plugins}

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64)  target=aarch64-apple-darwin ;;
  Darwin-x86_64) target=x86_64-apple-darwin ;;
  Linux-x86_64)  target=x86_64-unknown-linux-gnu ;;
  Linux-aarch64) target=aarch64-unknown-linux-gnu ;;
  *) echo "memory-hook: 不支持的平台 $(uname -s)-$(uname -m)" >&2; exit 0 ;;
esac

cache="${XDG_DATA_HOME:-$HOME/.local/share}/deep-memory/bin/$version"
bin="$cache/memory-hook"

# fetch_to <url> <dest>：把正文写入 dest，并把最终 HTTP 状态码打到标准输出。连不上时状态码为 000。
fetch_to() {
  _url=$1
  _dest=$2
  _code=$(curl -sS -L --retry 2 --output "$_dest" --write-out '%{http_code}' "$_url" 2>/dev/null) || _code=${_code:-000}
  _code=$(printf '%s' "$_code" | tr -cd '0-9')
  [ -n "$_code" ] || _code=000
  printf '%s' "$_code"
}

download() {
  url="https://github.com/$repo/releases/download/v$version/memory-hook-$target"
  mkdir -p "$cache"
  tmp="$bin.tmp.$$"
  rm -f "$tmp" "$tmp.sha"

  code=$(fetch_to "$url" "$tmp")
  if [ "$code" != "200" ] || [ ! -s "$tmp" ]; then
    if command -v gh >/dev/null 2>&1; then
      rm -f "$tmp"
      if gh release download "v$version" --repo "$repo" --pattern "memory-hook-$target" --output "$tmp" --clobber >/dev/null 2>&1 && [ -s "$tmp" ]; then
        code=200
      fi
    fi
  fi

  if [ "$code" = "404" ]; then
    echo "memory-hook: 下载失败：Release v${version} 没有资产 memory-hook-${target}（HTTP 404，$url）" >&2
    rm -f "$tmp" "$tmp.sha"
    return 1
  fi
  case "$code" in
    2??) ;;
    *)
      echo "memory-hook: 下载失败：HTTP ${code}（$url）" >&2
      rm -f "$tmp" "$tmp.sha"
      return 1
      ;;
  esac
  if [ ! -s "$tmp" ]; then
    echo "memory-hook: 下载失败：响应正文为空（$url）" >&2
    rm -f "$tmp" "$tmp.sha"
    return 1
  fi

  sha_code=$(fetch_to "$url.sha256" "$tmp.sha")
  expected=
  if [ "$sha_code" = "200" ] && [ -s "$tmp.sha" ]; then
    expected=$(awk '{print $1; exit}' "$tmp.sha")
  fi
  if [ -z "$expected" ] && command -v gh >/dev/null 2>&1; then
    gh_sha=$(gh release download "v$version" --repo "$repo" --pattern "memory-hook-$target.sha256" --output - 2>/dev/null || true)
    expected=$(printf '%s\n' "$gh_sha" | awk '{print $1; exit}')
  fi
  if [ -z "$expected" ]; then
    echo "memory-hook: 下载校验失败：缺少 memory-hook-${target}.sha256（$url.sha256）" >&2
    rm -f "$tmp" "$tmp.sha"
    return 1
  fi
  if command -v sha256sum >/dev/null 2>&1; then
    actual=$(sha256sum "$tmp" | awk '{print $1}')
  else
    actual=$(shasum -a 256 "$tmp" | awk '{print $1}')
  fi
  if [ "$expected" != "$actual" ]; then
    echo "memory-hook: 下载校验失败（${url}）" >&2
    rm -f "$tmp" "$tmp.sha"
    return 1
  fi
  chmod +x "$tmp"
  mv "$tmp" "$bin"
  rm -f "$tmp.sha"
}

if [ ! -x "$bin" ]; then
  echo "memory-hook: 正在下载 v${version}（${target}）…" >&2
  download || exit 1
fi
exec "$bin" "$@"
